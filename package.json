{
  "name": "agentforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The GitHub for AI Agents: an MCP-native, framework-agnostic agent registry.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:catalog && tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:catalog": "tsx scripts/export-catalog.ts",
    "build:mcp": "npm --prefix packages/mcp-server run build",
    "test": "tsx --test tests/*.test.ts",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-agentforge \"tsx --test tests/firestore.emulator.ts\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "firebase": "12.18.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@firebase/app": "0.16.1",
    "@firebase/app-compat": "0.5.17"
  },
  "engines": {
    "node": ">=22"
  }
}
