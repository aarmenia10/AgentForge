rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmail() { return signedIn() && request.auth.token.email_verified == true; }
    function bounded() { return request.query.limit != null && request.query.limit > 0 && request.query.limit <= 50; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function handlePath(handle) { return /databases/$(database)/documents/handles/$(handle); }
    function relationshipPath(uid, other) { return /databases/$(database)/documents/users/$(uid)/relationships/$(other); }
    function validHandle(handle) {
      return handle is string && handle.matches('^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$')
        && !(handle in ['agentforge', 'agentlemon', 'admin', 'support']);
    }
    function validProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasAll(['handle', 'display_name', 'avatar_url', 'created_at'])
        && data.keys().hasOnly(['handle', 'display_name', 'avatar_url', 'created_at'])
        && validHandle(data.handle)
        && data.display_name is string && data.display_name.size() > 0 && data.display_name.size() <= 100
        && data.display_name.matches('.*[^ ].*')
        && (data.avatar_url == null || (data.avatar_url is string && data.avatar_url.size() <= 2048 && data.avatar_url.matches('https://.+')))
        && getAfter(handlePath(data.handle)).data.uid == uid;
    }
    function validPreferences(data) {
      return data.keys().hasOnly(['work_role', 'use_for', 'goals', 'ai_apps', 'help_topics'])
        && (!data.keys().hasAny(['work_role']) || (data.work_role is string && data.work_role.size() <= 60))
        && (!data.keys().hasAny(['use_for']) || (data.use_for is list && data.use_for.size() <= 8))
        && (!data.keys().hasAny(['goals']) || (data.goals is list && data.goals.size() <= 7))
        && (!data.keys().hasAny(['ai_apps']) || (data.ai_apps is list && data.ai_apps.size() <= 7))
        && (!data.keys().hasAny(['help_topics']) || (data.help_topics is list && data.help_topics.size() <= 7));
    }
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && bounded();
      allow create: if signedIn() && request.auth.uid == uid && validProfile(uid)
        && request.resource.data.created_at == request.time;
      allow update: if signedIn() && request.auth.uid == uid && validProfile(uid)
        && request.resource.data.created_at == resource.data.created_at
        && (request.resource.data.handle == resource.data.handle || !existsAfter(handlePath(resource.data.handle)));
      match /relationships/{other} {
        function participant() { return signedIn() && request.auth.uid in [uid, other] && uid != other; }
        function mirrored() { return getAfter(relationshipPath(other, uid)).data == request.resource.data; }
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if signedIn() && request.auth.uid == uid && bounded();
        allow create: if participant() && verifiedEmail()
          && exists(userPath(uid)) && exists(userPath(other))
          && request.resource.data.keys().hasAll(['sender_uid', 'status', 'created_at'])
          && request.resource.data.keys().hasOnly(['sender_uid', 'status', 'created_at'])
          && request.resource.data.sender_uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.created_at == request.time
          && !exists(relationshipPath(other, uid)) && mirrored();
        allow update: if participant() && resource.data.status == 'pending'
          && resource.data.sender_uid != request.auth.uid
          && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && mirrored();
        allow delete: if participant() && !existsAfter(relationshipPath(other, uid));
      }
      match /private/{doc} {
        allow read: if signedIn() && request.auth.uid == uid && doc == 'preferences';
        allow create, update: if signedIn() && request.auth.uid == uid && doc == 'preferences'
          && validPreferences(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == uid && doc == 'preferences';
      }
    }
    match /handles/{handle} {
      allow get: if signedIn();
      allow create: if signedIn() && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.handle == handle;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.handle != handle;
    }
    match /connector_grants/{uid} {
      function validGrants() {
        let d = request.resource.data;
        return d.keys().hasAll(['epoch', 'grants']) && d.keys().hasOnly(['epoch', 'grants'])
          && d.epoch is int && d.epoch >= 0
          && d.grants is map && d.grants.size() <= 20;
      }
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validGrants();
      allow update: if signedIn() && request.auth.uid == uid && validGrants()
        && request.resource.data.epoch >= resource.data.epoch;
      allow list, delete: if false;
    }
    function validChatMarker(data) { return data.get('saved_from_chat', true) == true; }
    function validOriginApp(data) {
      return !('origin_app' in data) || data.origin_app in ['claude', 'chatgpt', 'other'];
    }
    function agentPath(agentId) { return /databases/$(database)/documents/agents/$(agentId); }
    function editPath(agentId) { return /databases/$(database)/documents/agent_edits/$(agentId); }
    function versionPath(data) { return /databases/$(database)/documents/agent_versions/$(data.id + '@' + data.version); }
    function snapshotted(data) { return getAfter(versionPath(data)).data == data; }
    function skillPath(skillId) { return /databases/$(database)/documents/skills/$(skillId); }
    function skillEditPath(skillId) { return /databases/$(database)/documents/skill_edits/$(skillId); }
    function skillVersionPath(data) { return /databases/$(database)/documents/skill_versions/$(data.id + '@' + data.version); }
    function skillSnapshotted(data) { return getAfter(skillVersionPath(data)).data == data; }
    function exportMarked(source, id) {
      let path = /databases/$(database)/documents/export_sources/$(source)/changes/$(id);
      return existsAfter(path) && (!exists(path) || getAfter(path).data.revision != get(path).data.revision);
    }
    // A vote marker is valid only while the caller's own vote document is
    // created, changed, or deleted in the same commit.
    function ownVoteChanged(path) {
      return existsAfter(path) != exists(path)
        || (exists(path) && getAfter(path).data != get(path).data);
    }
    match /export_sources/{source}/changes/{id} {
      // Coalesce commits for one document. The exporter alone reads these.
      function validChange() {
        return signedIn() && request.resource.data.keys().hasOnly(['revision'])
        && request.resource.data.revision is string && request.resource.data.revision.size() == 36
        && ((source == 'agents' && exists(agentPath(id))
              && ((!existsAfter(agentPath(id)) && liveApproved(get(agentPath(id)).data))
                || (existsAfter(agentPath(id))
                  && (getAfter(agentPath(id)).data != get(agentPath(id)).data || isAdmin()))))
          || (source == 'agent_versions' && isAdmin()
              && !exists(/databases/$(database)/documents/agent_versions/$(id))
              && existsAfter(/databases/$(database)/documents/agent_versions/$(id)))
          || (source == 'skills' && exists(skillPath(id))
              && ((!existsAfter(skillPath(id)) && liveApproved(get(skillPath(id)).data))
                || (existsAfter(skillPath(id))
                  && (liveApproved(get(skillPath(id)).data) || liveApproved(getAfter(skillPath(id)).data))
                  && (getAfter(skillPath(id)).data != get(skillPath(id)).data || isAdmin()))))
          || (source == 'skill_versions' && isAdmin()
              && !exists(/databases/$(database)/documents/skill_versions/$(id))
              && existsAfter(/databases/$(database)/documents/skill_versions/$(id)))
          || (source == 'votes' && id.matches('^agents_[a-z0-9]+(-[a-z0-9]+)*$')
              && exists(agentPath(id.split('_')[1]))
              && liveApproved(get(agentPath(id.split('_')[1])).data)
              && ownVoteChanged(agentVotePath(id.split('_')[1], request.auth.uid)))
          || (source == 'votes' && id.matches('^skills_[a-z0-9]+(-[a-z0-9]+)*$')
              && exists(skillPath(id.split('_')[1]))
              && liveApproved(get(skillPath(id.split('_')[1])).data)
              && ownVoteChanged(skillVotePath(id.split('_')[1], request.auth.uid)))
          || (source == 'comments' && id.matches('^agents_[a-z0-9]+(-[a-z0-9]+)*$')
              && exists(agentPath(id.split('_')[1]))
              && liveApproved(get(agentPath(id.split('_')[1])).data))
          || (source == 'comments' && id.matches('^skills_[a-z0-9]+(-[a-z0-9]+)*$')
              && exists(skillPath(id.split('_')[1]))
              && liveApproved(get(skillPath(id.split('_')[1])).data)));
      }
      function validCouncilChange() {
        let data = request.resource.data;
        return signedIn() && data.keys().hasOnly(['revision', 'changed_at'])
          && data.revision is string && data.revision.size() == 36 && data.changed_at == request.time
          && ((source == 'councils' && exists(councilPath(id))
              && ((!existsAfter(councilPath(id)) && liveApproved(get(councilPath(id)).data))
                || (existsAfter(councilPath(id))
                  && (liveApproved(get(councilPath(id)).data) || liveApproved(getAfter(councilPath(id)).data))
                  && getAfter(councilPath(id)).data != get(councilPath(id)).data)))
          || (source == 'council_versions' && isAdmin()
              && !exists(/databases/$(database)/documents/council_versions/$(id))
              && existsAfter(/databases/$(database)/documents/council_versions/$(id))));
      }
      allow create, update: if source in ['councils', 'council_versions'] ? validCouncilChange() : validChange();
    }
    match /agent_versions/{versionId} {
      allow read, update, delete: if false;
      allow create: if isAdmin()
        && exportMarked('agent_versions', versionId)
        && versionId == request.resource.data.id + '@' + request.resource.data.version
        && liveApproved(request.resource.data)
        && mayApprove(request.resource.data.owner_uid)
        && getAfter(agentPath(request.resource.data.id)).data == request.resource.data;
    }
    function liveApproved(data) { return data.visibility == 'public' && data.review_status == 'approved'; }
    function mayApprove(owner) {
      let config = /databases/$(database)/documents/config/review;
      return !exists(config) || get(config).data.allow_self_approval == true || request.auth.uid != owner;
    }
    match /config/{configId} { allow read, write: if false; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    function currentFriend(owner) {
      return signedIn() && get(relationshipPath(owner, request.auth.uid)).data.status == 'accepted';
    }
    function readableAgent(data) {
      return (signedIn() && data.owner_uid == request.auth.uid)
        || (data.visibility == 'public' && (data.review_status == 'approved' || isAdmin()))
        || (data.visibility == 'friends' && currentFriend(data.owner_uid));
    }
    function validAgent(data, agentId) {
      // Required fields are accessed below, so missing fields deny without a second key scan.
      return data.keys().hasOnly(['schema_version', 'visibility', 'id', 'name', 'version', 'description',
          'author', 'tags', 'framework', 'tools_required', 'input_schema', 'output_schema',
          'prompt_blueprint', 'stats', 'owner_uid', 'review_status', 'shared_with', 'saved_from_chat', 'origin_app'])
        && validChatMarker(data)
        && validOriginApp(data)
        && data.schema_version == 2
        && data.id == agentId && agentId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && data.visibility in ['public', 'friends', 'private']
        && data.review_status in ['pending', 'approved', 'rejected']
        && data.owner_uid is string && data.owner_uid.size() > 0
        && data.name is string && data.name.size() > 0
        && data.version is string && data.version.size() > 0
        && data.description is string && data.description.size() > 0
        && data.author is map
        && data.author.keys().hasOnly(['uid', 'name', 'handle', 'verified'])
        && data.author.uid == data.owner_uid
        && data.author.name is string && data.author.name.size() > 0
        && data.author.handle is string && data.author.handle.matches('^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$')
        && data.author.verified is bool
        && data.tags is list && data.tags.size() > 0
        && data.framework in ['crewai', 'langchain', 'autogen', 'mcp_native', 'custom']
        && data.tools_required is list && data.input_schema is map && data.output_schema is map
        && data.prompt_blueprint is map
        && data.prompt_blueprint.keys().hasOnly(['system_prompt', 'instructions', 'verification_rules'])
        && data.prompt_blueprint.system_prompt is string && data.prompt_blueprint.system_prompt.size() > 0
        && data.prompt_blueprint.instructions is list && data.prompt_blueprint.instructions.size() > 0
        && data.prompt_blueprint.verification_rules is list && data.prompt_blueprint.verification_rules.size() > 0
        && data.stats is map
        && data.stats.keys().hasOnly(['stars', 'views', 'updated_at'])
        && data.stats.stars is int && data.stats.stars >= 0
        && data.stats.views is int && data.stats.views >= 0
        && data.stats.updated_at is string
        && data.shared_with is list && data.shared_with.size() <= 100;
    }
    function ownIdentity(data) {
      return data.owner_uid == request.auth.uid && data.author.uid == request.auth.uid
        && data.author.handle == get(userPath(request.auth.uid)).data.handle;
    }
    function ownerEdit(agentId) {
      let before = resource.data;
      let after = request.resource.data;
      return verifiedEmail() && before.owner_uid == request.auth.uid
        && (!liveApproved(before) || (after.visibility != 'public'
          && after.diff(before).affectedKeys().hasOnly(['visibility', 'review_status', 'stats'])))
        && !existsAfter(editPath(agentId))
        && after.owner_uid == before.owner_uid
        && after.author.verified == before.author.verified
        && after.review_status == 'pending'
        && after.stats.stars == before.stats.stars && after.stats.views == before.stats.views
        && (after.shared_with == before.shared_with || after.shared_with == [])
        && ownIdentity(after) && validAgent(after, agentId);
    }
    function adminEdit(agentId) {
      // All other fields are unchanged; only validate the two admin-editable values.
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review_status', 'author'])
        && request.resource.data.author.diff(resource.data.author).affectedKeys().hasOnly(['verified'])
        && request.resource.data.review_status in ['pending', 'approved', 'rejected']
        && (request.resource.data.review_status == resource.data.review_status || request.resource.data.review_status != 'approved' || mayApprove(resource.data.owner_uid))
        && (liveApproved(request.resource.data) || !existsAfter(editPath(agentId)))
        && (request.resource.data.review_status != 'approved'
          || (resource.data.review_status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasAny(['author']))
          || snapshotted(request.resource.data))
        && request.resource.data.author.verified is bool;
    }
    function approveEdit(agentId) {
      let live = resource.data;
      let edit = get(editPath(agentId)).data;
      let after = request.resource.data;
      return isAdmin() && liveApproved(live) && mayApprove(live.owner_uid)
        && exists(editPath(agentId)) && !existsAfter(editPath(agentId))
        && edit.owner_uid == live.owner_uid && edit.version != live.version
        && edit.visibility == 'public' && edit.review_status in ['pending', 'rejected']
        && after.review_status == 'approved'
        && after.diff(edit).affectedKeys().hasOnly(['review_status', 'author', 'stats'])
        && after.author.diff(edit.author).affectedKeys().hasOnly(['verified'])
        && after.author.verified == live.author.verified
        && after.stats.updated_at == edit.stats.updated_at
        && after.stats.stars == live.stats.stars && after.stats.views == live.stats.views
        && snapshotted(after)
        && validAgent(after, agentId);
    }
    match /agent_edits/{agentId} {
      function ownsLive() { return verifiedEmail() && get(agentPath(agentId)).data.owner_uid == request.auth.uid; }
      function validEdit() {
        let live = get(agentPath(agentId)).data;
        let edit = request.resource.data;
        return ownsLive() && liveApproved(live) && validAgent(edit, agentId)
          && ownIdentity(edit) && edit.visibility == 'public' && edit.review_status == 'pending'
          && edit.version != live.version && edit.owner_uid == live.owner_uid
          && edit.author.verified == live.author.verified
          && edit.stats.stars == live.stats.stars && edit.stats.views == live.stats.views;
      }
      allow get: if (signedIn() && get(agentPath(agentId)).data.owner_uid == request.auth.uid) || isAdmin();
      allow list: if bounded() && ((signedIn() && resource.data.owner_uid == request.auth.uid) || isAdmin());
      allow create: if validEdit();
      allow update: if validEdit() || (isAdmin()
        && request.resource.data.review_status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review_status']));
      allow delete: if ownsLive() || (isAdmin() &&
        ((liveApproved(getAfter(agentPath(agentId)).data)
          && mayApprove(get(agentPath(agentId)).data.owner_uid)
          && getAfter(agentPath(agentId)).data.diff(resource.data).affectedKeys().hasOnly(['review_status', 'author', 'stats'])
          && getAfter(agentPath(agentId)).data.author.diff(resource.data.author).affectedKeys().hasOnly(['verified'])
          && getAfter(agentPath(agentId)).data.stats.updated_at == resource.data.stats.updated_at
          && getAfter(agentPath(agentId)).data.version == resource.data.version)
        || !liveApproved(getAfter(agentPath(agentId)).data)));
    }
    function noBlockedWords(body) {
      return !body.matches('(?is).*\\b(nigger|niggers|nigga|niggas|faggot|faggots|kike|kikes|spic|spics|chink|chinks|wetback|wetbacks|tranny|trannies|gook|gooks|raghead|ragheads|towelhead|towelheads|beaner|beaners|retard|retards)\\b.*');
    }
    function validComment(data) {
      return data.keys().hasOnly(['author_uid', 'author_handle', 'body', 'created_at', 'deleted'])
        && data.author_uid == request.auth.uid
        && validHandle(data.author_handle)
        && exists(userPath(request.auth.uid))
        && data.author_handle == get(userPath(request.auth.uid)).data.handle
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 1000
        && data.created_at == request.time
        && data.deleted == false;
    }
    function validReport(data) {
      return data.keys().hasOnly(['reason', 'note', 'created_at', 'updated_at'])
        && data.reason in ['spam', 'harmful', 'misleading', 'other']
        && (data.note == null || (data.note is string && data.note.size() <= 500))
        && data.created_at is timestamp
        && data.updated_at == request.time;
    }
    function agentVotePath(agentId, uid) { return /databases/$(database)/documents/agents/$(agentId)/votes/$(uid); }
    function skillVotePath(skillId, uid) { return /databases/$(database)/documents/skills/$(skillId)/votes/$(uid); }
    function validVote(data) {
      return data.keys().hasOnly(['value', 'created_at', 'updated_at'])
        && data.value in ['up', 'down']
        && (data.created_at == request.time || (resource != null && data.created_at == resource.data.created_at))
        && data.updated_at == request.time;
    }
    function validAgentVoteDelta(agentId) {
      let before = get(agentPath(agentId)).data;
      let after = getAfter(agentPath(agentId)).data;
      let hadStar = exists(starPath(agentId));
      let hadVote = exists(agentVotePath(agentId, request.auth.uid));
      let hasVoteAfter = existsAfter(agentVotePath(agentId, request.auth.uid));
      let oldIsUp = hadVote ? get(agentVotePath(agentId, request.auth.uid)).data.value == 'up' : hadStar;
      let newIsUp = hasVoteAfter && getAfter(agentVotePath(agentId, request.auth.uid)).data.value == 'up';
      let delta = (newIsUp ? 1 : 0) - (oldIsUp ? 1 : 0);
      return after.diff(before).affectedKeys().hasOnly(['stats'])
        && after.stats.diff(before.stats).affectedKeys().hasOnly(['stars'])
        && after.stats.stars is int && after.stats.stars >= 0
        && after.stats.stars == before.stats.stars + delta
        && !existsAfter(starPath(agentId));
    }
    function validSkillVoteDelta(skillId) {
      let before = get(skillPath(skillId)).data;
      let after = getAfter(skillPath(skillId)).data;
      let hadVote = exists(skillVotePath(skillId, request.auth.uid));
      let hasVoteAfter = existsAfter(skillVotePath(skillId, request.auth.uid));
      let oldVal = hadVote ? get(skillVotePath(skillId, request.auth.uid)).data.value : null;
      let newVal = hasVoteAfter ? getAfter(skillVotePath(skillId, request.auth.uid)).data.value : null;
      let upDelta = (newVal == 'up' ? 1 : 0) - (oldVal == 'up' ? 1 : 0);
      let downDelta = (newVal == 'down' ? 1 : 0) - (oldVal == 'down' ? 1 : 0);
      let oldUp = before.stats.get('thumbs_up', 0);
      let oldDown = before.stats.get('thumbs_down', 0);
      return after.diff(before).affectedKeys().hasOnly(['stats'])
        && after.stats.diff(before.stats).affectedKeys().hasOnly(['thumbs_up', 'thumbs_down'])
        && after.stats.get('thumbs_up', 0) == oldUp + upDelta
        && after.stats.get('thumbs_down', 0) == oldDown + downDelta
        && after.stats.get('thumbs_up', 0) >= 0
        && after.stats.get('thumbs_down', 0) >= 0;
    }
    function starPath(agentId) { return /databases/$(database)/documents/agents/$(agentId)/stars/$(request.auth.uid); }
    function validStarDelta(agentId) {
      let before = get(agentPath(agentId)).data;
      let after = getAfter(agentPath(agentId)).data;
      // Stars are legacy: a star can only be removed, which lowers the count by one.
      return after.diff(before).affectedKeys().hasOnly(['stats'])
        && after.stats.diff(before.stats).affectedKeys().hasOnly(['stars'])
        && after.stats.stars is int && after.stats.stars >= 0
        && after.stats.stars == before.stats.stars - 1
        && exists(starPath(agentId)) && !existsAfter(starPath(agentId));
    }
    function isAgentVoteDelta() {
      // Only a change of stats.stars alone is a vote. A stats-only edit that
      // touches updated_at (an owner saving unchanged content) is not.
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return diff.size() == 1 && diff.hasOnly(['stats'])
        && request.resource.data.stats.diff(resource.data.stats).affectedKeys().hasOnly(['stars']);
    }
    match /agents/{agentId} {
      // Public browsing still uses Hosting; these reads serve account views and stars.
      allow get: if (signedIn() && !exists(agentPath(agentId))) || readableAgent(resource.data);
      allow list: if bounded() && readableAgent(resource.data);
      allow create: if verifiedEmail() && ownIdentity(request.resource.data)
        && request.resource.data.review_status == 'pending'
        && request.resource.data.author.verified == false
        && request.resource.data.stats.stars == 0 && request.resource.data.stats.views == 0
        && request.resource.data.shared_with == []
        && validAgent(request.resource.data, agentId);
      allow update: if isAgentVoteDelta()
        ? (signedIn() && readableAgent(resource.data)
          && (validStarDelta(agentId) || validAgentVoteDelta(agentId))
          && (!liveApproved(resource.data) || exportMarked('votes', 'agents_' + agentId) || exportMarked('agents', agentId)))
        : (((!liveApproved(resource.data) && !liveApproved(request.resource.data))
            || exportMarked('agents', agentId))
          && (ownerEdit(agentId) || adminEdit(agentId) || approveEdit(agentId)));
      allow delete: if verifiedEmail() && resource.data.owner_uid == request.auth.uid
        && !existsAfter(editPath(agentId))
        && (!liveApproved(resource.data) || exportMarked('agents', agentId));
      match /stars/{userId} {
        allow get: if signedIn() && request.auth.uid == userId
          && readableAgent(get(agentPath(agentId)).data);
        // Thumbs replaced stars (P3-13). New stars would double count beside votes.
        allow create: if false;
        allow delete: if signedIn() && request.auth.uid == userId
          && readableAgent(get(agentPath(agentId)).data) && validStarDelta(agentId);
      }
      match /votes/{userId} {
        function canVote() {
